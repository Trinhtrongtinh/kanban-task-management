# GCP demo deployment sample
# Copy this to .env.gcp and replace YOUR_VM_EXTERNAL_IP with your VM public IP.

# Application
NODE_ENV=development
PORT=3001
BACKEND_URL=http://YOUR_VM_EXTERNAL_IP:3001
FRONTEND_URL=http://YOUR_VM_EXTERNAL_IP:3000

# Database - MySQL (Docker)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=trello_user
DB_PASSWORD=trello_pass
DB_DATABASE=trello_clone
DB_SSL=false
MYSQL_ROOT_PASSWORD=root123

# JWT
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth Cookies
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_CSRF_COOKIE_NAME=csrf_token
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://YOUR_VM_EXTERNAL_IP:3001/auth/google/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Frontend Public Keys
NEXT_PUBLIC_API_URL=http://YOUR_VM_EXTERNAL_IP:3001
NEXT_PUBLIC_SOCKET_URL=http://YOUR_VM_EXTERNAL_IP:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mail
MAIL_FROM=noreply@kanban.app
MAIL_FROM_NAME=Kanban App
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Auth Redirects
AUTH_SUCCESS_REDIRECT_URL=http://YOUR_VM_EXTERNAL_IP:3000/social-callback
AUTH_FAILURE_REDIRECT_URL=http://YOUR_VM_EXTERNAL_IP:3000/login?error=social_auth_failed

# Rate Limiting
RATE_LIMIT_DEFAULT_TTL_MS=60000
RATE_LIMIT_DEFAULT_AUTH_LIMIT=600
RATE_LIMIT_DEFAULT_ANON_LIMIT=300
RATE_LIMIT_DEFAULT_BLOCK_MS=30000

RATE_LIMIT_AUTH_TTL_MS=60000
RATE_LIMIT_AUTH_LIMIT=10000
RATE_LIMIT_AUTH_BLOCK_MS=300000

RATE_LIMIT_SEARCH_TTL_MS=60000
RATE_LIMIT_SEARCH_LIMIT=10000
RATE_LIMIT_SEARCH_BLOCK_MS=60000

RATE_LIMIT_UPLOAD_TTL_MS=60000
RATE_LIMIT_UPLOAD_LIMIT=10000
RATE_LIMIT_UPLOAD_BLOCK_MS=300000

RATE_LIMIT_WRITE_TTL_MS=60000
RATE_LIMIT_WRITE_LIMIT=10000
RATE_LIMIT_WRITE_BLOCK_MS=60000

RATE_LIMIT_DANGEROUS_TTL_MS=60000
RATE_LIMIT_DANGEROUS_LIMIT=10000
RATE_LIMIT_DANGEROUS_BLOCK_MS=120000

RATE_LIMIT_NOTIFICATION_BULK_TTL_MS=60000
RATE_LIMIT_NOTIFICATION_BULK_LIMIT=10000
RATE_LIMIT_NOTIFICATION_BULK_BLOCK_MS=60000

RATE_LIMIT_PAYMENTS_TTL_MS=60000
RATE_LIMIT_PAYMENTS_LIMIT=10000
RATE_LIMIT_PAYMENTS_BLOCK_MS=120000

RATE_LIMIT_READ_TTL_MS=60000
RATE_LIMIT_READ_AUTH_LIMIT=10000
RATE_LIMIT_READ_ANON_LIMIT=10000
RATE_LIMIT_READ_BLOCK_MS=60000