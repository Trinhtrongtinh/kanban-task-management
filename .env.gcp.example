# GCP demo deployment sample
# Copy this to .env.gcp and replace YOUR_VM_EXTERNAL_IP with your VM public IP.

NODE_ENV=development
MYSQL_ROOT_PASSWORD=root123
DB_USERNAME=trello_user
DB_PASSWORD=trello_pass
DB_DATABASE=trello_clone

FRONTEND_URL=http://YOUR_VM_EXTERNAL_IP:3000
BACKEND_URL=http://YOUR_VM_EXTERNAL_IP:3001
NEXT_PUBLIC_API_URL=http://YOUR_VM_EXTERNAL_IP:3001
NEXT_PUBLIC_SOCKET_URL=http://YOUR_VM_EXTERNAL_IP:3001

JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://YOUR_VM_EXTERNAL_IP:3001/auth/google/callback

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

AUTH_SUCCESS_REDIRECT_URL=http://YOUR_VM_EXTERNAL_IP:3000/social-callback
AUTH_FAILURE_REDIRECT_URL=http://YOUR_VM_EXTERNAL_IP:3000/login?error=social_auth_failed